# Local development — SQLite (default)
DATABASE_URL="file:./dev.db"

# Auth / admin
# Generate NEXTAUTH_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
# Generate ADMIN_PASSWORD_HASH:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
ADMIN_PASSWORD_HASH=""
# Generate MCP_ADMIN_API_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_ADMIN_API_KEY=""

# ---------------------------------------------------------------------------
# Production (Vercel + Neon) — set these in the Vercel project env, not here.
# From Neon dashboard → Connection details:
#   DATABASE_URL  = pooled connection string (for the app)
#   DIRECT_URL    = direct connection string (for Prisma db push / migrate)
# Also set on Vercel:
#   NEXTAUTH_URL  = https://YOUR_PROJECT.vercel.app  (or your custom domain)
#   NEXTAUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD_HASH, MCP_ADMIN_API_KEY
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
